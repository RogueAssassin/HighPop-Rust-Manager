<Project>
  <!-- Single source of the HighPop version for every project (Core, Windows app, Linux host).
       Release automation reads <Version> from this file. -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
  </PropertyGroup>
</Project>
