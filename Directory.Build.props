<Project>
  <!-- Single source of the HighPop version for every project (Core, Windows app, Linux host).
       Release automation reads <Version> from this file. -->
  <PropertyGroup>
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <InformationalVersion>1.3.1</InformationalVersion>
  </PropertyGroup>
</Project>
