<Project>
  <!-- Single source of the HighPop version for every project (Core, Windows app, Linux host).
       Release automation reads <Version> from this file. -->
  <PropertyGroup>
    <Version>1.2.5</Version>
    <AssemblyVersion>1.2.5.0</AssemblyVersion>
    <FileVersion>1.2.5.0</FileVersion>
    <InformationalVersion>1.2.5</InformationalVersion>
  </PropertyGroup>
</Project>
