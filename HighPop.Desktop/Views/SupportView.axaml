<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighPop.ViewModels"
             x:Class="HighPop.Desktop.Views.SupportView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource BgSurface2Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="22" />
      <Setter Property="Margin" Value="0,0,0,22" />
    </Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Opacity" Value="0.6" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.65" /></Style>
  </UserControl.Styles>

  <ScrollViewer Padding="32">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="HighPop" FontSize="34" FontWeight="Bold" />
      <TextBlock Text="Local-first control for serious Rust communities." Opacity="0.75" Margin="0,4,0,26" />

      <TextBlock Text="ABOUT" Classes="section" />
      <Border Classes="card">
        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Text="Version" Classes="muted" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="VersionText" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Check for updates" Command="{Binding CheckForWgsUpdateNowCommand}" />
            <TextBlock Text="{Binding WgsUpdateCheckResult}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Row="1" Text="Maintainer" Classes="muted" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="HighPop Contributors" FontWeight="SemiBold" />
          <TextBlock Grid.Row="2" Text="Platform" Classes="muted" />
          <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PlatformText" FontWeight="SemiBold" />
          <TextBlock Grid.Row="3" Text="License" Classes="muted" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT, source available on GitHub" FontWeight="SemiBold" />
        </Grid>
      </Border>

      <TextBlock Text="DIAGNOSTICS" Classes="section" />
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Local health and support bundle" FontSize="17" FontWeight="Bold" />
          <TextBlock x:Name="HealthSummaryText" Text="Loading health summary..." TextWrapping="Wrap"
                     FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource AccentBlueBrush}" />
          <TextBlock TextWrapping="Wrap" Opacity="0.75"
                     Text="Export readiness timestamps, recent lifecycle operations, environment details and bounded recent logs. Passwords, API tokens, encrypted secrets and Discord webhooks are redacted." />
          <Button x:Name="ExportButton" Content="Export redacted support bundle" Click="Export_Click" HorizontalAlignment="Left" />
          <TextBlock x:Name="BundleStatus" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>
      </Border>

      <TextBlock Text="PROJECT" Classes="section" />
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="HighPop Rust Manager" FontSize="17" FontWeight="Bold" />
          <TextBlock Text="Report issues, review the source, or contribute a pull request." TextWrapping="Wrap" Opacity="0.75" />
          <Button Content="Open GitHub repository" Click="GitHub_Click" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
