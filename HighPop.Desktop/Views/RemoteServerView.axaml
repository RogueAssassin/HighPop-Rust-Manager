<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighPop.ViewModels"
             xmlns:conv="using:HighPop.Desktop.Converters"
             x:Class="HighPop.Desktop.Views.RemoteServerView"
             x:DataType="vm:RemoteServerViewModel">
  <UserControl.Resources>
    <conv:ConsoleTypeBrushConverter x:Key="TypeBrush" />
  </UserControl.Resources>

  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Ellipse Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding StatusColor}" />
        <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="SemiBold" />
        <Border Background="{DynamicResource BgSurface3Brush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="{Binding GameName}" FontSize="11" Opacity="0.8" />
        </Border>
        <Border Background="{DynamicResource BgSurface3Brush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="{Binding MachineName}" FontSize="11" Foreground="{DynamicResource AccentBlueBrush}" />
        </Border>
      </StackPanel>
      <TextBlock Text="{Binding Status}" Opacity="0.75" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="success" Content="Start" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" />
        <Button Classes="danger" Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" />
        <Button Content="Restart" Command="{Binding RestartCommand}" IsEnabled="{Binding CanStop}" />
        <Button Content="Clear console" Command="{Binding ClearConsoleCommand}" />
      </StackPanel>
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <TextBox Text="{Binding ConsoleInput}" PlaceholderText="Type a console command and press Enter..."
               FontFamily="Consolas,Menlo,monospace" Margin="0,0,8,0">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SendConsoleCommandCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Content="Send" Command="{Binding SendConsoleCommandCommand}" />
    </Grid>

    <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
      <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Background="Transparent"
               FontFamily="Consolas,Menlo,monospace" FontSize="12">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock TextWrapping="NoWrap" Text="{ReflectionBinding Text}"
                       Foreground="{ReflectionBinding Type, Converter={StaticResource TypeBrush}}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</UserControl>
