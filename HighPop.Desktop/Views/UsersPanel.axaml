<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighPop.ViewModels"
             xmlns:svc="using:HighPop.Services"
             xmlns:views="using:HighPop.Desktop.Views"
             x:Class="HighPop.Desktop.Views.UsersPanel"
             x:DataType="vm:MainViewModel">
  <Border Background="{DynamicResource BgSurface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,14">
    <StackPanel Spacing="8">
      <TextBlock Text="User management" FontSize="15" FontWeight="SemiBold" />
      <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                 Text="Manage web dashboard users. Each user has an individual token for API access. The initial admin receives a random password; rotate its token before sharing access." />

      <Grid ColumnDefinitions="*,*,120,Auto" ColumnSpacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="Username" FontSize="12" Opacity="0.7" />
          <TextBox Text="{Binding NewUserName}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="Password" FontSize="12" Opacity="0.7" />
          <views:PasswordBox x:Name="NewUserPw" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="Role" FontSize="12" Opacity="0.7" />
          <ComboBox SelectedItem="{Binding NewUserRole}" HorizontalAlignment="Stretch">
            <x:String>Admin</x:String>
            <x:String>Viewer</x:String>
          </ComboBox>
        </StackPanel>
        <Button Classes="primary" Grid.Column="3" Content="Add" VerticalAlignment="Bottom"
                Command="{Binding AddUserCommand}" CommandParameter="{Binding #NewUserPw}" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Users}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="svc:WgsUser">
            <Border Background="{DynamicResource BgDeepBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RoleLabel}" FontSize="11" Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusLabel}" FontSize="11" Opacity="0.65" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Content="Toggle role" CommandParameter="{Binding}"
                            Command="{ReflectionBinding $parent[UserControl].DataContext.ChangeUserRoleCommand}" />
                    <Button Content="Enable / disable" CommandParameter="{Binding}"
                            Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleEnabledCommand}" />
                    <Button Content="New token" CommandParameter="{Binding}"
                            Command="{ReflectionBinding $parent[UserControl].DataContext.RegenerateTokenCommand}" />
                    <Button Content="Delete" CommandParameter="{Binding}"
                            Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteUserCommand}" />
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Token:" FontSize="10" Opacity="0.6" />
                  <TextBlock Text="{Binding Token}" FontSize="10" Opacity="0.6" FontFamily="Consolas,Menlo,monospace" />
                  <TextBlock Text="|  Last login:" FontSize="10" Opacity="0.6" />
                  <TextBlock Text="{Binding LastLoginText}" FontSize="10" Opacity="0.6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBox Width="200" PlaceholderText="New password" PasswordChar="●"
                           Text="{ReflectionBinding $parent[UserControl].DataContext.UserChangePassword, Mode=TwoWay}" />
                  <Button Content="Change password" CommandParameter="{Binding}"
                          Command="{ReflectionBinding $parent[UserControl].DataContext.ChangeUserPasswordCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <TextBlock Text="Audit log" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Content="Refresh" Command="{Binding RefreshAuditLogCommand}" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding AuditLog}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="svc:AuditEntry">
            <Border Background="{DynamicResource BgDeepBrush}" CornerRadius="4" Padding="10,5" Margin="0,0,0,2">
              <Grid ColumnDefinitions="140,100,140,*">
                <TextBlock Text="{Binding TimestampText}" FontSize="11" FontFamily="Consolas,Menlo,monospace" Opacity="0.65" />
                <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Action}" FontSize="11" Foreground="{DynamicResource AccentGreenBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
