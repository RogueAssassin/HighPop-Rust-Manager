<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HighPop.Desktop.Views.CloseWindow"
        Title="Close HighPop" Width="500" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24,20" Spacing="12">
    <TextBlock Text="HighPop is still managing your server" FontSize="16" FontWeight="SemiBold" />
    <Border Background="{DynamicResource BgSurface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
      <StackPanel Spacing="4">
        <TextBlock Text="Recommended" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="SemiBold" />
        <TextBlock Text="Keep running in the background" FontSize="14" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                   Text="Hides the window. Monitoring, console access, schedules, and running Rust servers stay fully connected. Use the tray icon to bring it back. If your desktop shows no system tray, choose Exit manager instead." />
        <Button Content="Keep running in background" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Minimize_Click" />
      </StackPanel>
    </Border>
    <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.65"
               Text="Exit detaches HighPop but does not stop Rust. Reopening HighPop verifies the saved process identity and reconnects to it. Console lines emitted while HighPop is closed cannot be recovered." />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="Cancel_Click" />
      <Button Content="Exit manager" Click="Exit_Click" />
    </StackPanel>
  </StackPanel>
</Window>
