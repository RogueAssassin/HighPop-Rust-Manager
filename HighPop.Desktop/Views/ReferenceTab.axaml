<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighPop.ViewModels"
             xmlns:svc="using:HighPop.Services"
             xmlns:conv="using:HighPop.Desktop.Converters"
             xmlns:ctl="using:HighPop.Desktop.Controls"
             xmlns:oxy="clr-namespace:OxyPlot.Avalonia;assembly=OxyPlot.Avalonia"
             x:Class="HighPop.Desktop.Views.ReferenceTab"
             x:DataType="vm:ServerViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="18" Background="{DynamicResource BgDeepBrush}">
    <Border Classes="card" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="section" Text="Rogue Rust Reference" Margin="0,0,0,4" />
          <TextBlock Text="Search live Rust server commands and ConVars. Insert places the selected name into the console for review; it never executes automatically."
                     Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding RustReferenceStatus}" Margin="0,7,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Content="Open website" Command="{Binding OpenRustReferenceCommand}" />
          <Button Classes="primary" Content="Load / Refresh" IsEnabled="{Binding !RustReferenceLoading}" Command="{Binding RefreshRustReferenceCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
      <Grid ColumnDefinitions="*,160" ColumnSpacing="10">
        <TextBox Text="{Binding RustReferenceSearch}" ToolTip.Tip="Search by command name, description, or execution scope" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding RustReferenceKinds}" SelectedItem="{Binding RustReferenceKind}" HorizontalAlignment="Stretch" />
      </Grid>
    </Border>
    <ListBox Grid.Row="2" ItemsSource="{Binding RustReferenceEntries}" SelectedItem="{Binding SelectedRustReferenceEntry}"
             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.Styles>
        <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,7" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="svc:RustReferenceEntry">
          <Border Classes="card" Padding="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Name}" FontFamily="Consolas,Menlo,monospace" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                  <Border Background="{DynamicResource BgSurface2Brush}" CornerRadius="3" Padding="6,2">
                    <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource AccentGreenBrush}" />
                  </Border>
                  <TextBlock Text="{Binding Scope}" FontSize="10" Margin="0,2,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Margin="0,5,0,0" FontSize="11" FontFamily="Consolas,Menlo,monospace" Foreground="{DynamicResource TextMutedBrush}">
                  <Run Text="Default: " /><Run Text="{Binding DefaultText}" />
                </TextBlock>
              </StackPanel>
              <Button Grid.Column="1" Content="Insert" Margin="14,0,0,0" VerticalAlignment="Center" CommandParameter="{Binding}"
                      Command="{ReflectionBinding $parent[UserControl].DataContext.InsertRustReferenceCommand}"
                      ToolTip.Tip="Place this name in the Console input without executing it" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid></UserControl>
