<!-- Same names and values as HighPop/Themes/Colors.xaml (the Windows app), so a view can move between the two unchanged. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Background layers -->
  <Color x:Key="BgDeepColor">#0B0D14</Color>
  <Color x:Key="BgSurfaceColor">#10131C</Color>
  <Color x:Key="BgSurface2Color">#161A25</Color>
  <Color x:Key="BgSurface3Color">#1E2331</Color>

  <!-- Accent colours -->
  <Color x:Key="AccentBlueColor">#38BDF8</Color>
  <Color x:Key="AccentVioletColor">#A855F7</Color>
  <Color x:Key="AccentGreenColor">#34C77B</Color>
  <Color x:Key="AccentRedColor">#F06A6A</Color>
  <Color x:Key="AccentYellowColor">#FFB020</Color>
  <Color x:Key="AccentOrangeColor">#F59E0B</Color>

  <!-- Text -->
  <Color x:Key="TextPrimaryColor">#EEF1F8</Color>
  <Color x:Key="TextSecondaryColor">#AEB6C8</Color>
  <Color x:Key="TextMutedColor">#7A8398</Color>

  <!-- Border -->
  <Color x:Key="BorderColor">#252B3A</Color>

  <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}" />
  <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
  <SolidColorBrush x:Key="BgSurface2Brush" Color="{StaticResource BgSurface2Color}" />
  <SolidColorBrush x:Key="BgSurface3Brush" Color="{StaticResource BgSurface3Color}" />

  <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
  <SolidColorBrush x:Key="AccentVioletBrush" Color="{StaticResource AccentVioletColor}" />
  <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
  <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />
  <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellowColor}" />
  <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrangeColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderActiveBrush" Color="{StaticResource AccentBlueColor}" />

  <!-- Shared selection palette used by lists and dropdowns. -->
  <SolidColorBrush x:Key="SelectionActiveBrush" Color="#29214A" />
  <SolidColorBrush x:Key="SelectionInactiveBrush" Color="#1C2034" />

  <!-- Button tints from the Windows styles. -->
  <SolidColorBrush x:Key="SuccessBgBrush" Color="#153C32" />
  <SolidColorBrush x:Key="SuccessFgBrush" Color="#B8FFD2" />
  <SolidColorBrush x:Key="DangerBgBrush" Color="#421C2A" />
  <SolidColorBrush x:Key="DangerFgBrush" Color="#FFD5DD" />

  <!-- Violet at the product edge, cyan at the action edge. -->
  <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="#8B5CF6" Offset="0" />
    <GradientStop Color="#2563EB" Offset="0.52" />
    <GradientStop Color="#22D3EE" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BrandHeaderBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#141226" Offset="0" />
    <GradientStop Color="#10141F" Offset="0.55" />
    <GradientStop Color="#0E171E" Offset="1" />
  </LinearGradientBrush>

  <!-- Overrides of the Fluent theme's own brushes, so hover, focus and selection follow the HighPop palette. -->
  <StaticResource x:Key="ButtonBackground" ResourceKey="BgSurface3Brush" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#262C3E" />
  <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="BgSurface2Brush" />
  <StaticResource x:Key="ButtonForeground" ResourceKey="TextSecondaryBrush" />
  <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
  <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextPrimaryBrush" />
  <StaticResource x:Key="ButtonBorderBrush" ResourceKey="BorderBrush" />
  <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AccentBlueBrush" />
  <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AccentBlueBrush" />
  <StaticResource x:Key="ListBoxItemBackgroundPointerOver" ResourceKey="BgSurface2Brush" />
  <StaticResource x:Key="ListBoxItemBackgroundSelected" ResourceKey="BgSurface3Brush" />
  <StaticResource x:Key="ListBoxItemBackgroundSelectedPointerOver" ResourceKey="BgSurface3Brush" />
  <StaticResource x:Key="ListBoxItemBackgroundSelectedPressed" ResourceKey="BgSurface3Brush" />
  <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="BgSurface3Brush" />
  <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="SelectionActiveBrush" />
  <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="SelectionActiveBrush" />
  <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="SelectionActiveBrush" />
  <StaticResource x:Key="TextControlBackground" ResourceKey="BgSurface2Brush" />
  <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="BgSurface2Brush" />
  <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="BgSurface2Brush" />
  <StaticResource x:Key="TextControlBorderBrush" ResourceKey="BorderBrush" />
  <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="BorderBrush" />
  <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AccentBlueBrush" />
  <StaticResource x:Key="ComboBoxBackground" ResourceKey="BgSurface2Brush" />
  <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="BgSurface2Brush" />
  <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="BgSurface2Brush" />
  <StaticResource x:Key="ComboBoxBackgroundFocused" ResourceKey="BgSurface2Brush" />
  <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="BorderBrush" />
  <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="AccentBlueBrush" />
  <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="AccentBlueBrush" />
  <StaticResource x:Key="ComboBoxBorderBrushFocused" ResourceKey="AccentBlueBrush" />
  <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="BgSurface2Brush" />
  <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="BorderBrush" />

</ResourceDictionary>
