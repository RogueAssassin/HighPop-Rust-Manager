<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background layers -->
    <Color x:Key="BgDeepColor">#070811</Color>
    <Color x:Key="BgSurfaceColor">#0D101A</Color>
    <Color x:Key="BgSurface2Color">#141827</Color>
    <Color x:Key="BgSurface3Color">#1B2134</Color>

    <!-- Accent colors -->
    <Color x:Key="AccentBlueColor">#22D3EE</Color>
    <Color x:Key="AccentVioletColor">#A855F7</Color>
    <Color x:Key="AccentGreenColor">#38C976</Color>
    <Color x:Key="AccentRedColor">#FF5D5D</Color>
    <Color x:Key="AccentYellowColor">#FFB020</Color>
    <Color x:Key="AccentOrangeColor">#F59E0B</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F5F7FF</Color>
    <Color x:Key="TextSecondaryColor">#B8C1D9</Color>
    <Color x:Key="TextMutedColor">#77819A</Color>

    <!-- Border -->
    <Color x:Key="BorderColor">#27324A</Color>
    <Color x:Key="BorderActiveColor">#22D3EE</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgDeepBrush"     Color="{StaticResource BgDeepColor}"/>
    <SolidColorBrush x:Key="BgSurfaceBrush"  Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgSurface2Brush" Color="{StaticResource BgSurface2Color}"/>
    <SolidColorBrush x:Key="BgSurface3Brush" Color="{StaticResource BgSurface3Color}"/>

    <SolidColorBrush x:Key="AccentBlueBrush"   Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="AccentVioletBrush" Color="{StaticResource AccentVioletColor}"/>
    <SolidColorBrush x:Key="AccentGreenBrush"  Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="AccentRedBrush"    Color="{StaticResource AccentRedColor}"/>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellowColor}"/>
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrangeColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderActiveBrush"  Color="{StaticResource BorderActiveColor}"/>
    <SolidColorBrush x:Key="TransparentBrush"   Color="Transparent"/>
    <!-- Shared Files-page selection palette, used across lists and dropdowns. -->
    <SolidColorBrush x:Key="SelectionActiveBrush" Color="#29214A"/>
    <SolidColorBrush x:Key="SelectionInactiveBrush" Color="#1C2034"/>

    <!-- Shared Rogue ecosystem lighting: violet at the product edge, cyan at the action edge. -->
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#8B5CF6" Offset="0"/>
        <GradientStop Color="#2563EB" Offset="0.52"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandHeaderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#17112C" Offset="0"/>
        <GradientStop Color="#0D1528" Offset="0.55"/>
        <GradientStop Color="#081A24" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
