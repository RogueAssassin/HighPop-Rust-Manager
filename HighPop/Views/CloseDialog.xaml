<Window x:Class="HighPop.Views.CloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close HighPop" Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource BgDeepBrush}" CornerRadius="14"
            BorderBrush="{StaticResource BorderActiveBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource BrandHeaderBrush}"
                    CornerRadius="13,13,0,0" Padding="20,14"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/HighPop;component/assets/brand/highpop-mark.png"
                               Width="34" Height="34" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel>
                            <TextBlock Text="HighPop is still managing your server"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="15"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Choose how the manager should close"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="✕" Width="32" Height="32" Padding="0"
                            HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                            Click="CancelClick" ToolTip="Cancel"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,20,22,18">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Recommended" Foreground="{StaticResource AccentGreenBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="Keep running in the background" FontSize="14"
                                   FontWeight="SemiBold" Margin="0,3,0,3"/>
                        <TextBlock Text="Hides the window to the system tray. Monitoring, console access, schedules, and running Rust servers stay fully connected."
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                        <Button Content="Keep running in background" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="MinimizeClick"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Exit detaches HighPop but does not stop Rust. Reopening HighPop verifies the saved process identity and reconnects to it. Console lines emitted while HighPop is closed cannot be recovered."
                           TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource BgSurfaceBrush}"
                    CornerRadius="0,0,13,13" Padding="22,14"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0" Click="CancelClick"/>
                    <Button Content="Exit manager" Style="{StaticResource DangerButton}"
                            Click="CloseAppClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
