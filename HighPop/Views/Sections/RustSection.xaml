<UserControl x:Class="HighPop.Views.Sections.RustSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf">
    <ScrollViewer Background="{StaticResource BgDeepBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Rust Settings" Style="{StaticResource SectionHeader}"/>

            <!-- Custom join domain: DNS checker for the Facepunch A + _rust._udp SRV setup -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Custom join domain" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Players can join with client.connect your.domain once it has an A record (DNS only, not proxied) to your public IP and a _rust._udp SRV record with the game port. Set Public join domain in Settings so favourites follow the domain."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                 Text="{Binding DomainCheckHostname, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Hostname to check, e.g. rust.example.com. Leave empty to use Public join domain from Settings."/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="🔎 Check DNS" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    IsEnabled="{Binding DomainChecking, Converter={StaticResource InvBool}}"
                                    Command="{Binding CheckCustomDomainCommand}"/>
                            <Button Content="📘 Setup guide" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenCustomDomainGuideCommand}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding DomainCheckSummary}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,6"/>
                    <ItemsControl ItemsSource="{Binding DomainCheckItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSurface2Brush}" CornerRadius="5"
                                        Padding="10,7" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon, Mode=OneWay}" FontSize="13"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding DomainConnectCommand, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="Players type in F1:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DomainConnectCommand}" FontFamily="Consolas" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,8,0"/>
                        <Button Content="📋 Copy" Style="{StaticResource GhostButton}"
                                Command="{Binding CopyDomainConnectCommandCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="HighPop operations profile" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="This label helps HighPop present the intended server type. Installing Carbon or Oxide automatically changes a vanilla profile to Modded."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <ComboBox ItemsSource="{Binding RustServerProfileOptions}"
                              SelectedItem="{Binding RustServerProfile}"
                              Style="{StaticResource DarkComboBox}" Width="260"
                              HorizontalAlignment="Left"/>
                    <TextBlock Text="SteamCMD branch" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                    <ComboBox ItemsSource="{Binding RustSteamBranchOptions}"
                              Text="{Binding RustSteamBranch, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Style="{StaticResource DarkComboBox}" Width="260"
                              HorizontalAlignment="Left"/>
                    <TextBlock Text="Use public for a normal live server. staging and aux branches are development/test builds and may make the server appear as development."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <Border Background="#2A1D0C" BorderBrush="{StaticResource AccentOrangeBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,0">
                        <TextBlock Text="Official status is assigned by Facepunch. A community server cannot become Official through a launch argument or manager setting."
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource AccentOrangeBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Server browser tags" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Choose Rust's documented operator tags. Wipe schedule, difficulty, and region groups allow one selection each; Rust displays up to four at once. Modded, Oxide, and Carbon are detected/reported by the framework instead."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <ItemsControl ItemsSource="{Binding RustBrowserTags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                          Style="{StaticResource DarkCheckBox}" Width="160"
                                          Margin="0,0,8,8" ToolTip="{Binding Value}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Server custom variables" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="HighPop reads active variables from the identity's cfg\server.cfg. Save updates changed rows and adds new enabled rows without replacing your comments or unrelated settings. Rust applies server.cfg at startup and it overrides matching command-line defaults."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,5"/>
                    <TextBlock Text="{Binding ServerConfigPath}" FontSize="10" FontFamily="Consolas"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding RustVariableStatus}" FontSize="10"
                               Foreground="{StaticResource AccentOrangeBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RustVariableFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"
                                 ToolTip="Filter by variable name or purpose"/>
                        <Border Grid.Column="1" Style="{StaticResource StatusPill}" Margin="8,0,0,0">
                            <TextBlock Foreground="{StaticResource AccentOrangeBrush}">
                                <Run Text="{Binding RustVariablePendingCount, Mode=OneWay}"/>
                                <Run Text=" pending"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                    <Grid Margin="10,0,40,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Use" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="Variable" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="2" Text="Value" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="3" Text="Purpose" Style="{StaticResource FieldLabel}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding FilteredRustServerVariables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSurface2Brush}" CornerRadius="5"
                                        Padding="10,7" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled}" Style="{StaticResource DarkCheckBox}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkTextBox}" FontFamily="Consolas" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkTextBox}" FontFamily="Consolas" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="4" Content="✕" Style="{StaticResource DangerButton}"
                                                Width="30" Padding="0" Margin="8,0,0,0"
                                                Command="{Binding DataContext.RemoveRustServerVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Add variable" Style="{StaticResource GhostButton}"
                                Command="{Binding AddRustServerVariableCommand}" Margin="0,0,8,0"/>
                        <Button Content="💾 Save to server.cfg" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveServerConfigVariablesCommand}" Margin="0,0,8,0"/>
                        <Button Content="⚡ Save + apply live" Style="{StaticResource SuccessButton}"
                                Command="{Binding ApplyRustVariablesLiveCommand}" Margin="0,0,8,0"
                                ToolTip="Writes server.cfg, then sends changed enabled values to the running Rust console. Disabled variables require a restart."/>
                        <Button Content="↻ Reload from file" Style="{StaticResource GhostButton}"
                                Command="{Binding ReloadServerConfigVariablesCommand}" Margin="0,0,8,0"/>
                        <Button Content="📝 Open server.cfg" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenServerConfigCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Rust log directory" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Leave the custom location empty to use server\&lt;identity&gt;\logs under the Rust installation."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <TextBlock Text="Custom location (optional, absolute path)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CustomLogDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}"
                                Command="{Binding BrowseLogDirectoryCommand}" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="Use default" Style="{StaticResource GhostButton}"
                                Command="{Binding ResetLogDirectoryCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="Effective directory" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding EffectiveLogDirectory}" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <Button Content="📂 Open log directory" Style="{StaticResource GhostButton}"
                            Command="{Binding OpenLogDirectoryCommand}" HorizontalAlignment="Left"
                            Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Stage 5 local telemetry" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Opt in to HighPop's versioned local JSONL event stream. This foundation records lifecycle, operator-action, and player-count events; the later Carbon/uMod bridge and live-map adapter will use the same schema."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <CheckBox IsChecked="{Binding Server.RustTelemetryEnabled}"
                              Style="{StaticResource DarkCheckBox}"
                              Content="Record local Rust telemetry for this server"
                              Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Retention (days)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Server.RustTelemetryRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Maximum storage (MB)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Server.RustTelemetryMaxMegabytes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding TelemetryDirectory}" FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                    <Button Content="📂 Open telemetry directory" Style="{StaticResource GhostButton}"
                            Command="{Binding OpenTelemetryDirectoryCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
