<UserControl x:Class="HighPop.Views.Sections.ModsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf">
    <ScrollViewer Background="{StaticResource BgDeepBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Mod Manager" Style="{StaticResource SectionHeader}"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Detected framework" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding DetectedModFramework}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentGreenBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="↻ Rescan" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshInstalledPluginsCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Framework-aware Windows Explorer shortcuts -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Windows Explorer shortcuts" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Shortcuts open folders for this server only. Framework shortcuts are available only when exactly one installed framework is detected; HighPop never creates the other framework's missing folders."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <WrapPanel>
                        <Button Content="📂 Server files" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenInstallFolderCommand}" Margin="0,0,8,8"/>
                        <Button Content="📂 Rust config" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenServerConfigDirectoryCommand}" Margin="0,0,8,8"/>
                        <Button Content="📂 Rust logs" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenLogDirectoryCommand}" Margin="0,0,8,8"/>
                        <Button Content="📂 Framework root" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenActiveFrameworkFolderCommand}" Margin="0,0,8,8"
                                Visibility="{Binding HasSingleModFramework, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="📂 Active plugins" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenActivePluginFolderCommand}" Margin="0,0,8,8"
                                Visibility="{Binding HasSingleModFramework, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="📂 Plugin configs" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenActiveModConfigFolderCommand}" Margin="0,0,8,8"
                                Visibility="{Binding HasSingleModFramework, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="📂 Extensions" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenActiveExtensionFolderCommand}" Margin="0,0,8,8"
                                Visibility="{Binding HasSingleModFramework, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Status bar -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding ModStatusText, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ModStatusText}" FontSize="13"
                           Foreground="{StaticResource AccentBlueBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- Oxide section -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding Plugin.SupportsOxide, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Oxide / uMod" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Border Background="{StaticResource BgSurface2Brush}" CornerRadius="3"
                                Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Rust compatibility framework" FontSize="11"
                                       Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12">
                        Downloads and installs the latest Oxide (uMod) framework directly into the server folder.
                        Stop Rust first and do not combine Oxide with Carbon. Place plugins in oxide/plugins/.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="⬇ Install / Update Oxide" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0"
                                Command="{Binding InstallOxideCommand}"
                                IsEnabled="{Binding CanInstallOxide}"/>
                        <Button Content="📂 Open plugins folder" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenPluginFolderCommand}"
                                Visibility="{Binding IsOxideInstalled, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Carbon section (Rust only) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsRust, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Carbon" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Border Background="#2A1D0C" BorderBrush="{StaticResource AccentOrangeBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="High-performance Rust framework" FontSize="11"
                                       Foreground="{StaticResource AccentOrangeBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Installs the latest stable official Carbon Windows release. Stop Rust first and do not combine Carbon with Oxide; plugins and configuration are preserved during updates."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="⬇ Install / Update Carbon" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" Command="{Binding InstallCarbonCommand}"
                                IsEnabled="{Binding CanInstallCarbon}"/>
                        <Button Content="📂 Open Carbon plugins" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenCarbonPluginFolderCommand}"
                                Visibility="{Binding IsCarbonInstalled, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- RogueRust extension -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsRust, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource AccentOrangeBrush}" CornerRadius="3"/>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RogueRust Extension" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="RogueAssassin/Oxide.Ext.RogueRust"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource StatusPill}">
                                <TextBlock Text="{Binding RogueRustStatus}" Foreground="{StaticResource AccentGreenBrush}"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Release channel" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RogueRustChannelOptions}"
                                      SelectedItem="{Binding RogueRustChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsStopped}"/>
                            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="Stable is recommended for production. Testing is intended for development servers and may contain unreleased changes."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="Installs the selected Stable or Testing RogueRust build into the active framework's correct extension location: RustDedicated_Data/Managed for Oxide/uMod or carbon/extensions for Carbon. Every download is SHA-256 verified. If both frameworks are detected, both copies update as one transaction; any failure restores all changed targets. The newest 20 rollback copies are retained per target."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⬇ Install / Update RogueRust" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding InstallRogueRustCommand}" Margin="0,0,8,0"
                                    IsEnabled="{Binding ModBusy, Converter={StaticResource InvBool}}"/>
                            <Button Content="✓ Run diagnostics" Style="{StaticResource GhostButton}"
                                    Command="{Binding CheckRogueRustHealthCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RogueRust plugin catalog (plugins.roguegaming.com.au) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RogueRust plugin catalog" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="plugins.roguegaming.com.au" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🌐 Open site" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                    Command="{Binding OpenPluginCatalogSiteCommand}"/>
                            <Button Content="↻ Load catalog" Style="{StaticResource GhostButton}"
                                    IsEnabled="{Binding PluginCatalogLoading, Converter={StaticResource InvBool}}"
                                    Command="{Binding RefreshPluginCatalogCommand}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Single-file plugins built on the RogueRust extension. Install/Update downloads the .cs only from plugins.roguegaming.com.au/plugins/, checks its [Info] header, keeps the last 5 versions in highpop-plugin-backups, and swaps it into the active framework's plugins folder in one step so Oxide/Carbon hot-loads it."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding PluginCatalogStatus}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding CatalogPlugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSurface2Brush}" CornerRadius="5"
                                        Padding="10,7" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding VersionText, Mode=OneWay}" Margin="8,0,0,0"
                                                           Foreground="{StaticResource AccentBlueBrush}"/>
                                                <TextBlock Text="{Binding Category, Mode=OneWay}" Margin="8,0,0,0" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText, Mode=OneWay}" FontSize="11"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{StaticResource AccentGreenBrush}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Docs" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenCatalogPluginDocsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="{Binding ActionText, Mode=OneWay}" Style="{StaticResource PrimaryButton}"
                                                    IsEnabled="{Binding DataContext.ModBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvBool}}"
                                                    Command="{Binding DataContext.InstallCatalogPluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Installed plugins" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="HighPop scans the Oxide and Carbon plugin folders. Disabled .off and .disabled files remain visible."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <TextBlock Text="No plugins were found." FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4"
                               Visibility="{Binding InstalledPlugins.Count, Converter={StaticResource ZeroToVis}, Mode=OneWay}"/>
                    <ItemsControl ItemsSource="{Binding InstalledPlugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSurface2Brush}" CornerRadius="5"
                                        Padding="10,7" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FileName}" FontFamily="Consolas"
                                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Framework}"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding StateText}"
                                                   VerticalAlignment="Center" Foreground="{StaticResource AccentGreenBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LastModified, StringFormat='{}{0:g}'}"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
