                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                <ToggleButton Content="Info" IsChecked="{Binding ShowConsoleInfo}"
                                              Style="{StaticResource GhostToggleButton}" Padding="9,3"/>
                                <ToggleButton Content="Warnings" IsChecked="{Binding ShowConsoleWarnings}"
                                              Style="{StaticResource GhostToggleButton}" Padding="9,3" Margin="5,0,0,0"/>
                                <ToggleButton Content="Errors" IsChecked="{Binding ShowConsoleErrors}"
                                              Style="{StaticResource GhostToggleButton}" Padding="9,3" Margin="5,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <ToggleButton Content="⏸ Pause" IsChecked="{Binding IsConsolePaused}"
                                              Style="{StaticResource GhostToggleButton}" Padding="9,3"
                                              ToolTip="Pause screen updates while the complete log continues recording"/>
                                <ToggleButton x:Name="AutoScrollToggle" IsChecked="True"
