<UserControl x:Class="HighPop.Views.ServerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HighPop.ViewModels"
             xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
             xmlns:s="clr-namespace:HighPop.Views.Sections"
             Background="{StaticResource BgDeepBrush}">
    <UserControl.Resources>
        <!-- One template per section, instantiated by DeferredSection on first view. -->
        <DataTemplate x:Key="ConsoleSectionTemplate"><s:ConsoleSection/></DataTemplate>
        <DataTemplate x:Key="ReferenceSectionTemplate"><s:ReferenceSection/></DataTemplate>
        <DataTemplate x:Key="PlayersSectionTemplate"><s:PlayersSection/></DataTemplate>
        <DataTemplate x:Key="SettingsSectionTemplate"><s:SettingsSection/></DataTemplate>
        <DataTemplate x:Key="RustSectionTemplate"><s:RustSection/></DataTemplate>
        <DataTemplate x:Key="ConfigSectionTemplate"><s:ConfigSection/></DataTemplate>
        <DataTemplate x:Key="ModsSectionTemplate"><s:ModsSection/></DataTemplate>
        <DataTemplate x:Key="AutomationSectionTemplate"><s:AutomationSection/></DataTemplate>
        <DataTemplate x:Key="ScheduleSectionTemplate"><s:ScheduleSection/></DataTemplate>
        <DataTemplate x:Key="BackupsSectionTemplate"><s:BackupsSection/></DataTemplate>
        <DataTemplate x:Key="LogWatcherSectionTemplate"><s:LogWatcherSection/></DataTemplate>
        <DataTemplate x:Key="InfoSectionTemplate"><s:InfoSection/></DataTemplate>
        <DataTemplate x:Key="ChartsSectionTemplate"><s:ChartsSection/></DataTemplate>
        <DataTemplate x:Key="ActionLogSectionTemplate"><s:ActionLogSection/></DataTemplate>
        <DataTemplate x:Key="FilesSectionTemplate"><s:FilesSection/></DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Border Grid.Row="0" Background="{StaticResource BrandHeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14,24,10">
            <StackPanel>
                <!-- Server name row -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding StatusColor, Converter={StaticResource StrToColor}}"/>
                    <TextBlock Text="{Binding Server.DisplayName}" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"/>
                    <Border Background="{StaticResource BgSurface2Brush}" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Plugin.GameName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <Border Background="{StaticResource BgSurface2Brush}" CornerRadius="4" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Plugin.Category}" FontSize="11" Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Uptime: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding UptimeText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding LifecycleDetailText}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,0,8"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Lifecycle command deck -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="▶  Start" Style="{StaticResource SuccessButton}" Margin="0,0,6,0"
                            Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"/>
                    <Button Content="■  Stop safely" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                            Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"/>
                    <Button Content="Force Stop PID" Style="{StaticResource DangerButton}" Margin="0,0,6,0"
                            Command="{Binding ForceStopCommand}" IsEnabled="{Binding CanForceStop}"
                            ToolTip="Force-close the exact Rust PID started by HighPop, including its process tree."/>
                    <Button Content="↻  Restart" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                            Command="{Binding RestartCommand}" IsEnabled="{Binding CanStop}" ToolTip="Restart"/>
                    <Button Content="↓  Install / Update" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                            Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstallServerFiles}"
                            ToolTip="Pulls and validates the latest Rust Dedicated Server files. Stop Rust before using this button."/>
                    <Button Content="📁" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Width="36" Padding="0"
                            Command="{Binding OpenInstallFolderCommand}" ToolTip="Open install folder"/>
                    <Button Content="🎮" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Width="36" Padding="0"
                            Command="{Binding JoinServerCommand}" IsEnabled="{Binding IsRunning}"
                            ToolTip="Join server (steam://connect)"/>
                    <Button Content="🔗" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Width="36" Padding="0"
                            Command="{Binding CopyConnectionLinkCommand}"
                            ToolTip="Copy steam://connect link to clipboard"/>
                    <Button Content="⧉" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Width="36" Padding="0"
                            Command="{Binding DataContext.CloneServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Clone server (copy config, allocate new ports)"/>
                    <Button Content="⇧" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Width="36" Padding="0"
                            Command="{Binding DataContext.ExportServerProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Export this server's portable HPRM settings"/>
                    <Button Content="🗑" Style="{StaticResource DangerButton}" Width="36" Padding="0"
                            Command="{Binding DataContext.RemoveServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Remove server from list"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══ PERF BAR ══ -->
        <Border Grid.Row="1" Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,8"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <!-- CPU -->
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="CPU" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:F1}}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="%" FontSize="12" VerticalAlignment="Bottom" Margin="1,0,0,1"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding CpuPercent}" Maximum="100" Width="120"
                                 Style="{StaticResource DarkProgressBar}" Foreground="{StaticResource AccentBlueBrush}"/>
                </StackPanel>
                <!-- RAM -->
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="RAM" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding MemoryMb}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text=" MB" FontSize="12" VerticalAlignment="Bottom" Margin="1,0,0,1"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding MemoryMb}" Maximum="16384" Width="120"
                                 Style="{StaticResource DarkProgressBar}" Foreground="{StaticResource AccentGreenBrush}"/>
                </StackPanel>
                <!-- Bandwidth -->
                <StackPanel Margin="0,0,32,0" VerticalAlignment="Center">
                    <TextBlock Text="Bandwidth ↓" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding NetIn}" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource AccentGreenBrush}"/>
                    <TextBlock Text="Bandwidth ↑" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding NetOut}" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource AccentBlueBrush}"/>
                </StackPanel>
                <!-- Connections -->
                <StackPanel Margin="0,0,32,0" VerticalAlignment="Center">
                    <TextBlock Text="Connections" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding ConnectionCount}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <!-- RCON status -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"
                            Visibility="{Binding HasRcon, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="RCON" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding RconConnected, Converter={StaticResource StrToColor}}"/>
                        <TextBlock Margin="6,0,0,0" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Disconnected"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RconConnected}" Value="True">
                                            <Setter Property="Text" Value="Connected"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══ INSTALL PROGRESS ══ -->
        <Border Grid.Row="1" Padding="24,10" Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{Binding InstallProgressText}" FontSize="12" Foreground="{StaticResource AccentBlueBrush}"/>
                    <TextBlock Text="{Binding InstallProgress}" Margin="8,0,0,0" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <ProgressBar Value="{Binding InstallProgress}" Maximum="100" Style="{StaticResource DarkProgressBar}"/>
            </StackPanel>
        </Border>

        <!-- ══ TABS ══ -->
        <!-- ══ SECTIONS ══
             A grouped sidebar instead of one long tab strip. Every section lives in its own file
             under Views/Sections; DeferredSection builds it the first time it is opened and keeps it,
             and only the section on screen is rebound when the selected server changes. -->
        <TabControl Grid.Row="2" Style="{StaticResource SectionNav}">
            <TabItem Header="Console" Tag="🖥">
                <TabControl Style="{StaticResource SubTabs}">
                    <TabItem Header="{Binding Loc.TabConsole}">
                        <s:DeferredSection Template="{StaticResource ConsoleSectionTemplate}"/>
                    </TabItem>
                    <TabItem Header="Reference" Visibility="{Binding IsRust, Converter={StaticResource BoolToVis}}">
                        <s:DeferredSection Template="{StaticResource ReferenceSectionTemplate}"/>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Players" Tag="👥">
                <s:DeferredSection Template="{StaticResource PlayersSectionTemplate}"/>
            </TabItem>

            <TabItem Header="Configure" Tag="🛠">
                <TabControl Style="{StaticResource SubTabs}">
                    <TabItem Header="{Binding Loc.TabSettings}">
                        <s:DeferredSection Template="{StaticResource SettingsSectionTemplate}"/>
                    </TabItem>
                    <TabItem Header="Rust" Visibility="{Binding IsRust, Converter={StaticResource BoolToVis}}">
                        <s:DeferredSection Template="{StaticResource RustSectionTemplate}"/>
                    </TabItem>
                    <TabItem Header="Config files">
                        <s:DeferredSection Template="{StaticResource ConfigSectionTemplate}"/>
                    </TabItem>
                    <TabItem Header="Mods" Visibility="{Binding HasModSupport, Converter={StaticResource BoolToVis}}">
                        <s:DeferredSection Template="{StaticResource ModsSectionTemplate}"/>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Automation" Tag="⏱">
                <TabControl Style="{StaticResource SubTabs}">
                    <TabItem Header="Automation">
                        <s:DeferredSection Template="{StaticResource AutomationSectionTemplate}"/>
                    </TabItem>
                    <TabItem Header="Schedule">
                        <s:DeferredSection Template="{StaticResource ScheduleSectionTemplate}"/>
                    </TabItem>
                    <TabItem Header="{Binding Loc.TabBackups}">
                        <s:DeferredSection Template="{StaticResource BackupsSectionTemplate}"/>
                    </TabItem>
                    <TabItem Header="Log watcher">
                        <s:DeferredSection Template="{StaticResource LogWatcherSectionTemplate}"/>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Monitoring" Tag="📈">
                <TabControl Style="{StaticResource SubTabs}">
                    <TabItem Header="{Binding Loc.TabInfo}">
                        <s:DeferredSection Template="{StaticResource InfoSectionTemplate}"/>
                    </TabItem>
                    <TabItem Header="Charts">
                        <s:DeferredSection Template="{StaticResource ChartsSectionTemplate}"/>
                    </TabItem>
                    <TabItem Header="Action log">
                        <s:DeferredSection Template="{StaticResource ActionLogSectionTemplate}"/>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Files" Tag="📂">
                <s:DeferredSection Template="{StaticResource FilesSectionTemplate}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
